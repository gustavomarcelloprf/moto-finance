# =============================================================================
# MotoFinance — Environment Variables
# =============================================================================
# Copie este arquivo para .env.local e preencha com seus valores.
# Nunca commitar .env.local — está no .gitignore.
# =============================================================================

# ---- Supabase (M1+) ----
# Crie projeto em https://supabase.com -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
SUPABASE_SERVICE_ROLE_KEY="ey..."     # NUNCA expor no client — usado apenas server-side

# ---- Database (Drizzle direct connection, opcional) ----
# Use connection string com PgBouncer (porta 6543) para serverless,
# e direct (porta 5432) para migrations
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DATABASE_DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Asaas (M2+) ----
# Sandbox: https://sandbox.asaas.com — produção: https://www.asaas.com
ASAAS_API_KEY=""
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_WEBHOOK_TOKEN=""

# ---- OneSignal (M2+) ----
NEXT_PUBLIC_ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""

# ---- Sentry (M2+) ----
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- PostHog (M2+) ----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ---- Resend (M2+, transactional email) ----
RESEND_API_KEY=""
